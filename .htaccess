Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Offre 333 — en ligne.
#   /            → /333/
#   /index.html  → /333/
#   /444 (ancienne offre) → /333/
#
# Quand 333 sera terminée et qu'aucune offre n'est en ligne :
# remplacer les 3 RewriteRule par :
#   RewriteRule ^(333|444)(/.*)?$ / [R=302,L]
# ──────────────────────────────────────────────────────────────

RewriteRule ^$ /333/ [R=302,L]
RewriteRule ^index\.html?$ /333/ [R=302,L]
RewriteRule ^444(/.*)?$ /333/ [R=302,L]
