Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Aucune offre spéciale en cours.
#   /            → sert index.html (page « pas d'offre en cours »)
#   /222, /333, /444, /888 (offres closes) → /
#
# Quand la prochaine offre X ouvrira :
# remplacer la RewriteRule par les 3 rules du pattern précédent :
#   RewriteRule ^$ /X/ [R=302,L]
#   RewriteRule ^index\.html?$ /X/ [R=302,L]
#   RewriteRule ^(anciennes-offres)(/.*)?$ /X/ [R=302,L]
# ──────────────────────────────────────────────────────────────

RewriteRule ^(222|333|444|888)(/.*)?$ / [R=302,L]
