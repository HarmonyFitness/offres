Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Pas d'offre en cours — page d'attente sur / (sert /index.html automatiquement).
# Quand offre 333 prête : ajouter ici "RewriteRule ^$ /333/ [R=302,L]"
# et "RewriteRule ^index\.html?$ /333/ [R=302,L]", puis ajuster la règle ci-dessous.

# Ancien chemin /444 — renvoie vers la page d'attente
RewriteRule ^444(/.*)?$ / [R=302,L]
