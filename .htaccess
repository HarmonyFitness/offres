Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Aucune offre spéciale « en cours » sur /.
#   /            → sert index.html (page « pas d'offre en cours »)
#   /222, /333, /444, /888 (offres closes) → /
#   /halloween/  → accessible en direct (Offre Halloween 888, lien diffusé
#                  par les managers), mais pas mise en avant sur /
#
# Pour en faire l'offre en cours :
#   RewriteRule ^$ /halloween/ [R=302,L]
#   RewriteRule ^index\.html?$ /halloween/ [R=302,L]
#   RewriteRule ^(222|333|444|888)(/.*)?$ /halloween/ [R=302,L]
# ──────────────────────────────────────────────────────────────

RewriteRule ^(222|333|444|888)(/.*)?$ / [R=302,L]
