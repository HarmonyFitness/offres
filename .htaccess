Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Offre 222 — offre principale.
#   /            → /222/
#   /index.html  → /222/
#   /333, /444 (anciennes offres) → /222/
#   /888 reste accessible en direct (offre parallèle, non promue depuis la home)
#
# Quand 222 sera terminée et qu'aucune offre n'est en ligne :
# remplacer les 3 RewriteRule par :
#   RewriteRule ^(222|333|444|888)(/.*)?$ / [R=302,L]
# ──────────────────────────────────────────────────────────────

RewriteRule ^$ /222/ [R=302,L]
RewriteRule ^index\.html?$ /222/ [R=302,L]
RewriteRule ^(333|444)(/.*)?$ /222/ [R=302,L]
