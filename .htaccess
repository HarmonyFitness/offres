Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Offre en cours : Offre Halloween 888 → /halloween/
# jusqu'au dimanche 1er novembre 2026 à 23h59 (heure de Zurich : le serveur
# Apache est réglé sur Europe/Zurich, vérifié le 28.10.2026).
#
#   Avant le 02.11.2026 00h00 :
#     /, /index.html            → /halloween/
#     /222, /333, /444, /888    → /halloween/
#   Ensuite, automatiquement (aucun déploiement nécessaire) :
#     /            → sert index.html (page « pas d'offre en cours »)
#     /222, /333, /444, /888 → /
#
#   /halloween-maa/ → accessible en direct, pas mise en avant sur /
#
# %{TIME} = AAAAMMJJHHMMSS (heure locale du serveur), comparé comme texte.
# ──────────────────────────────────────────────────────────────

RewriteCond %{TIME} <20261102000000
RewriteRule ^(index\.html?)?$ /halloween/ [R=302,L]

RewriteCond %{TIME} <20261102000000
RewriteRule ^(222|333|444|888)(/.*)?$ /halloween/ [R=302,L]

RewriteRule ^(222|333|444|888)(/.*)?$ / [R=302,L]
