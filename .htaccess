Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Offre en cours : Offre Halloween 888 → /halloween/ (15 oct. → 1er nov. 2026)
#   /, /index.html          → /halloween/
#   /222, /333, /444, /888 (offres closes) → /halloween/
#
# Quand l'offre se termine : revenir à la page « pas d'offre en cours »
# (supprimer les 3 rules ci-dessous et rediriger ^(222|333|444|888|halloween)(/.*)?$ vers /).
# ──────────────────────────────────────────────────────────────

RewriteRule ^$ /halloween/ [R=302,L]
RewriteRule ^index\.html?$ /halloween/ [R=302,L]
RewriteRule ^(222|333|444|888)(/.*)?$ /halloween/ [R=302,L]
