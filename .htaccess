Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Aucune offre en cours mise en avant sur /.
#   /            → sert index.html (page « pas d'offre en cours »)
#   Offres closes → /
#     /222, /333, /444, /888
#     /halloween, /halloween-maa (Offres Halloween 888, terminées le 01.11.2026)
#
#   /blackfriday/ → accessible en direct uniquement (Offre Black Friday 888,
#                   prévente puis Black Friday du 25 au 29.11.2026), pas de
#                   redirection depuis /. La page masque elle-même ses boutons
#                   d'achat après la fin de l'offre.
# ──────────────────────────────────────────────────────────────

RewriteRule ^(222|333|444|888|halloween|halloween-maa)(/.*)?$ / [R=302,L]
