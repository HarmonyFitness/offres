Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# Aucune offre spéciale en cours.
#   /            → sert index.html (page « pas d'offre en cours »)
#   Offres closes → /
#     /222, /333, /444, /888
#     /halloween, /halloween-maa (Offres Halloween 888, terminées le 01.11.2026)
#
# Pour une future offre X en cours (jusqu'à une date donnée, heure de Zurich) :
#   RewriteCond %{TIME} <AAAAMMJJ000000
#   RewriteRule ^(index\.html?)?$ /X/ [R=302,L]
#   (le serveur Apache est réglé sur Europe/Zurich)
# ──────────────────────────────────────────────────────────────

RewriteRule ^(222|333|444|888|halloween|halloween-maa)(/.*)?$ / [R=302,L]
