Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────────
# État courant : aucune offre en ligne.
#   /            → page d'attente (sert /index.html automatiquement)
#   /444 et /333 → renvoient aussi vers la page d'attente
#
# Pour réactiver une offre (ex. 333) :
#   1) Retirer "333" de la règle ci-dessous
#   2) Ajouter au-dessus :
#        RewriteRule ^$ /333/ [R=302,L]
#        RewriteRule ^index\.html?$ /333/ [R=302,L]
# ──────────────────────────────────────────────────────────────

RewriteRule ^(333|444)(/.*)?$ / [R=302,L]
