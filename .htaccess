Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Offre 444 — active jusqu'au 31 mai 2026 23:59:59 (heure serveur).
# Après cette date, /index.html (page d'attente) prend le relais.
# Quand offre 333 prête : remplacer 444 par 333 et mettre à jour la date.
RewriteCond %{TIME} <20260601000000
RewriteRule ^$ /444/ [R=302,L]
RewriteCond %{TIME} <20260601000000
RewriteRule ^index\.html?$ /444/ [R=302,L]

# À partir du 1er juin 2026 → /444/ renvoie vers la page d'attente
RewriteCond %{TIME} >20260531235959
RewriteRule ^444(/.*)?$ / [R=302,L]
